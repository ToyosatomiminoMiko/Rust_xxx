      "text": "取消2015年LCK夏季赛冠军"
    },
    {
      "level": 3,
      "num": "16.",
      "text": "取消2016年LCK春季赛冠军"
    },
    {
      "level": 3,
      "num": "17.",
      "text": "取消2017年LCK春季赛冠军"
    },
    {
      "level": 3,
      "num": "18.",
